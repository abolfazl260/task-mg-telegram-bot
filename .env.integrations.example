# Example: https://bot.example.com
INTEGRATION_REDIRECT_BASE_URL=
INTEGRATION_HOST=0.0.0.0
INTEGRATION_PORT=8080

# Microsoft Entra application credentials
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Google Cloud OAuth 2.0 Web application credentials
GOOGLE_TASKS_CLIENT_ID=
GOOGLE_TASKS_CLIENT_SECRET=
