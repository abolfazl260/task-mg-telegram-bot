# Public HTTPS base URL of the bot server used for OAuth callbacks.
# Example: https://bot.example.com
INTEGRATION_REDIRECT_BASE_URL=
INTEGRATION_HOST=0.0.0.0
INTEGRATION_PORT=8080

# Microsoft Entra application credentials
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Google Cloud OAuth 2.0 Web application credentials
GOOGLE_TASKS_CLIENT_ID=
GOOGLE_TASKS_CLIENT_SECRET=

# Telegram voice -> speech-to-text
# STT_API_KEY can reuse GROQ_API_KEY when omitted.
STT_PROVIDER=groq
STT_API_KEY=
STT_API_URL=https://api.groq.com/openai/v1/audio/transcriptions
STT_MODEL=whisper-large-v3-turbo
# Optional ISO-639-1 language code. Leave empty for provider auto-detection.
STT_LANGUAGE=
VOICE_MAX_SIZE_MB=20
VOICE_MAX_DURATION_SECONDS=300
